# Production Environment Template for /opt/soichose/.env on DigitalOcean VPS
# Generate secrets cleanly with: openssl rand -hex 32

POSTGRES_USER=soichose
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=soichose

FRONTEND_URL=https://app.soichose.com

# Separate 64-char hex keys (MANDATORY in production)
AUTH_SECRET=CHANGE_ME_64_CHAR_HEX_SESSION_KEY
BACKUP_SECRET=CHANGE_ME_64_CHAR_HEX_VAULT_ROOT_KEY

# Google OAuth 2.0 Client ID (authorize https://app.soichose.com in Google Cloud Console)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# AI Companion & Decision Analyst
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
AI_API_KEY=
AI_MODEL=openai/gpt-4o
AI_GATEWAY_URL=https://api.openai.com/v1

# Web Push VAPID keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@soichose.com
