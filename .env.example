# Server Configuration
PORT=4000
NODE_ENV=development
# Required in production. Generate a unique random secret of at least 32 characters.
AUTH_SECRET=

# Database Connection (SQLite in local dev, PostgreSQL in cloud production)
DATABASE_URL="file:./dev.db"

# Real Google OAuth 2.0 Client ID (Audience verification)
# Must match the Client ID created in Google Cloud Console
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# AI Gateway / LLM Provider Configuration
AI_API_KEY=""
AI_MODEL="openai/gpt-4o"
AI_GATEWAY_URL="https://api.openai.com/v1"

# Server-side assistant configuration
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Browser push. Generate one keypair per environment and keep it stable.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@decision-replay.dev
