# Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Required in production (64+ hex chars via `openssl rand -hex 32`)
AUTH_SECRET=
BACKUP_SECRET=

# Database Connection (SQLite in local dev, PostgreSQL in Docker/VPS production)
DATABASE_URL="file:./dev.db"

# Real Google OAuth 2.0 Client ID (Audience verification)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# AI Gateway / LLM Provider Configuration
AI_API_KEY=""
AI_MODEL="openai/gpt-4o"
AI_GATEWAY_URL="https://api.openai.com/v1"

# Server-side assistant configuration
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Browser push notifications (generate one VAPID keypair per environment)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@soichose.com
