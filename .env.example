# Server Configuration
PORT=4000
NODE_ENV=development

# Database Connection (SQLite in local dev, PostgreSQL in cloud production)
DATABASE_URL="file:./dev.db"

# Real Google OAuth 2.0 Client ID (Audience verification)
# Must match the Client ID created in Google Cloud Console
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# AI Gateway / LLM Provider Configuration
AI_API_KEY=""
AI_MODEL="openai/gpt-4o"
AI_GATEWAY_URL="https://api.openai.com/v1"
